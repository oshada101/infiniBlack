---
import { contact } from '../data/site';

interface Props {
  base: string;
  /** where the section anchors live. Empty on the homepage, where they are
      plain in-page anchors; the homepage URL on any other page. */
  home?: string;
  /** which link reads as current. The homepage hands this to its scrollspy
      instead; a standalone page has no scroll to spy on. */
  active?: 'home' | 'services' | 'work';
}

const { base, home = '', active = 'home' } = Astro.props;
const link = (hash = '') => (home ? `${home}${hash}` : hash || '#');
const on = (name: string) => (active === name ? ' is-active' : '');

// One list, two renderings: the bar above 860px, the panel below it. Typing
// the destinations twice is how a menu ends up offering something the nav
// doesn't (or the other way round) six months from now.
//
// No "Home": the mark in the corner already is that link, on every page.
const items = [
  { name: 'services', label: 'Services', hash: '#services' },
  { name: 'work', label: 'Work', hash: '#work' },
  { name: 'contact', label: 'Contact', hash: '#contact' },
];

// The request dialog only exists on the homepage, where Contact.astro binds
// every [data-contact-open]. Anywhere else the same words take you to it.
const onHome = !home;

const diamond =
  'M 56 10.2 L 94 74.8 Q 100 85 94 95.2 L 56 159.8 Q 50 170 44 159.8 L 6 95.2 Q 0 85 6 74.8 L 44 10.2 Q 50 0 56 10.2 Z';
---

<nav class="nav" aria-label="Main">
  <a class="nav__word" href={link()} aria-label="infiniblack — home">
    <img class="nav__logo" src={`${base}logo-black.png`} alt="" />
  </a>

  <div class="nav__links">
    {items.map((item) => (
      <a class={`nav__link${on(item.name)}`} href={link(item.hash)}>
        <span class="nav__pip" aria-hidden="true"></span>
        {item.label}
      </a>
    ))}
  </div>

  <div class="nav__right">
    {onHome ? (
      <button class="cta cta--sm" type="button" data-contact-open>
        Make a request
        <svg class="cta__mark" viewBox="0 0 100 170" fill="currentColor" aria-hidden="true"><path d={diamond} /></svg>
      </button>
    ) : (
      <a class="cta cta--sm" href={link('#contact')}>
        Make a request
        <svg class="cta__mark" viewBox="0 0 100 170" fill="currentColor" aria-hidden="true"><path d={diamond} /></svg>
      </a>
    )}

    {/* Below 860px the links and the button move into the panel this opens.
        It stays a real <button> so it is keyboard- and AT-reachable, and the
        label rides next to the rule pair — a bare hamburger asks the visitor
        to recognise an icon, a word doesn't. Hidden above the breakpoint
        from global.css, not with a utility: the rule there is unlayered and
        would win over Tailwind's layered `hidden` regardless. */}
    <button
      class="nav__toggle"
      type="button"
      aria-controls="nav-menu"
      aria-expanded="false"
      data-nav-toggle
    >
      <span class="nav__toggle-label" aria-hidden="true">Menu</span>
      <span class="nav__burger" aria-hidden="true"><i></i><i></i></span>
      <span class="sr-only">Open menu</span>
    </button>
  </div>

  {/* THE PANEL — a child of the fixed nav, not a sibling. The nav carries a
      z-index, so it is a stacking context: anything inside it is above the
      whole page without this file having to know which section stacks where.
      It hangs off the bar, and the bar stays lit and clickable over it — the
      control that opened the menu is the control that closes it. */}
  <div class="nav__menu" id="nav-menu" data-nav-menu>
    <ul class="nav__menu-list">
      {items.map((item, i) => (
        <li class="nav__menu-row" style={`--i:${i}`}>
          <a class={`nav__menu-link${on(item.name)}`} href={link(item.hash)} data-nav-close>
            <span class="nav__menu-label">
              <span class="nav__pip" aria-hidden="true"></span>
              {item.label}
            </span>
            <span class="nav__menu-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 18 18 6M8.5 6H18v9.5" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>

    {/* the panel closes on the thing most people opened it for */}
    <div class="nav__menu-foot" style={`--i:${items.length}`}>
      {onHome ? (
        <button class="cta" type="button" data-contact-open data-nav-close>
          Make a request
          <svg class="cta__mark" viewBox="0 0 100 170" fill="currentColor" aria-hidden="true"><path d={diamond} /></svg>
        </button>
      ) : (
        <a class="cta" href={link('#contact')} data-nav-close>
          Make a request
          <svg class="cta__mark" viewBox="0 0 100 170" fill="currentColor" aria-hidden="true"><path d={diamond} /></svg>
        </a>
      )}
      <a class="nav__menu-mail" href={`mailto:${contact.email}`} data-nav-close>{contact.email}</a>
    </div>
  </div>
</nav>

<script>
  const nav = document.querySelector('.nav') as HTMLElement | null;
  const toggle = document.querySelector('[data-nav-toggle]') as HTMLButtonElement | null;
  const menu = document.querySelector('[data-nav-menu]') as HTMLElement | null;

  // glass once the page has moved at all; floating on the ground before that
  if (nav) {
    const sync = () => nav.classList.toggle('is-scrolled', window.scrollY > 8);
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }

  /* One "Make a request" on screen at a time. While the hero's own button is
     in view the bar's waits; it arrives as that one leaves. Pages with no
     hero button (a project page) never hide it. */
  const heroCta = document.querySelector('.hero-cta');
  if (nav && heroCta) {
    // the strip under the bar doesn't count as in view: a button sitting
    // behind the glass is one nobody can press
    new IntersectionObserver(
      ([entry]) => nav.classList.toggle('is-cta-held', entry.isIntersecting),
      { rootMargin: `-${nav.offsetHeight}px 0px 0px 0px` },
    ).observe(heroCta);
  }

  if (toggle && menu) {
    const label = toggle.querySelector('.sr-only') as HTMLElement | null;

    const setOpen = (open: boolean) => {
      document.documentElement.classList.toggle('is-nav-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
      // the scroll lock smooth-scroll.ts already reads (it checks body's
      // inline overflow directly), so the wheel stays off the page behind
      // the panel without a second mechanism for it to learn about
      document.body.style.overflow = open ? 'hidden' : '';
    };

    const isOpen = () => document.documentElement.classList.contains('is-nav-open');

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    // Every link in the panel closes it. The section links are in-page
    // anchors on the homepage — without this the panel would sit over the
    // section it just scrolled to. This listener is bound before the contact
    // dialog's (this script comes first in the page), so the panel lets go of
    // the scroll lock before the dialog takes it.
    menu.querySelectorAll('[data-nav-close]').forEach((el) =>
      el.addEventListener('click', () => setOpen(false))
    );

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Resizing past the breakpoint with the panel open would leave the page
    // locked under a menu that is no longer displayed.
    const wide = window.matchMedia('(min-width: 861px)');
    wide.addEventListener('change', (e) => {
      if (e.matches && isOpen()) setOpen(false);
    });
  }
</script>
