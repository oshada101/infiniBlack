---
/* THE TEASER — stands over every page until launch.
 *
 * The holding page, as an overlay: the logo's i with the site's prism field
 * moving inside it, one line, the date, and a way to reach us. The field
 * leans a little toward the pointer — a mouse anywhere on the screen, or a
 * finger dragged across a phone.
 *
 * Layout.astro renders it while `launch.enabled` and puts `is-teaser` on
 * <html>; an inline script in the head takes that class off before first
 * paint once the launch time has passed (or for a ?preview pass), and then
 * this never shows and its script never starts. Everything else on the page
 * is display:none underneath it, so the site's own WebGL fields, loader and
 * scroll don't run behind a wall nobody can see through.
 *
 * Self-contained on purpose — styles are in this file, not global.css — so
 * taking the teaser out after launch is deleting one file and one line.
 */
import { launch } from '../data/site';

// "Tuesday, 10 November", read in the launch's own timezone, not the
// build machine's
const parts = new Intl.DateTimeFormat('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  timeZone: 'Asia/Colombo',
}).formatToParts(new Date(launch.at));
const part = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
const dateLabel = `${part('weekday')}, ${part('day')} ${part('month')}.`;
---

<div class="teaser" id="teaser" data-at={launch.at}>
  <main class="teaser__main">
    <div class="teaser__aperture" aria-hidden="true"><div class="teaser__i"><canvas></canvas></div></div>
    <div class="teaser__copy">
      <h1 class="teaser__rise"><span>{launch.headline}</span></h1>
      <p class="teaser__when teaser__rise"><span><time datetime={launch.at}>{dateLabel}</time></span></p>
    </div>
  </main>
  <footer class="teaser__foot">
    <span class="teaser__name">infiniblack</span>
    <nav aria-label="Contact">
      {launch.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </footer>
</div>

<style is:global>
  /* ------------------------------------------------------------------ *
   *  Hiding the site. While <html> carries is-teaser, nothing in <body>
   *  but the teaser is rendered at all; without it, the teaser isn't.
   * ------------------------------------------------------------------ */
  html:not(.is-teaser) .teaser { display: none; }
  html.is-teaser body > :not(.teaser) { display: none !important; }
  html.is-teaser,
  html.is-teaser body { overflow: hidden; background: #0a0a0d; }

  .teaser {
    --t-ink: #0a0a0d;
    --t-paper: #f2f2f2;
    --t-grey-500: #8a8a92;
    --t-grey-300: #d4d4d8;
    --t-out: cubic-bezier(0.22, 1, 0.36, 1);
    --t-aperture: cubic-bezier(0.16, 1, 0.3, 1);
    /* the i: square dot (w), gap 0.72w, square stem 4.15w, so 5.87w tall */
    --i-h: clamp(210px, 44svh, 500px);

    position: fixed;
    inset: 0;
    z-index: 1000;
    /* scrolls only where the screen is too short to hold it all */
    overflow-y: auto;
    display: grid;
    grid-template-rows: 1fr auto;
    background: var(--t-ink);
    color: var(--t-paper);
    font-family: var(--font-display);
    line-height: normal;
    -webkit-font-smoothing: antialiased;
    /* a sideways drag leans the field instead of being taken for a swipe */
    touch-action: pan-y;
  }
  .teaser * { box-sizing: border-box; margin: 0; }

  .teaser__main {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(28px, 5svh, 56px);
    padding: 48px 16px 24px;
    text-align: center;
  }

  /* outer box opens from its centre (the brand's aperture); the inner box
     holds the i's shape, so the field never scales while it opens */
  .teaser__aperture {
    height: var(--i-h);
    aspect-ratio: 1 / 5.87;
    animation: teaser-open 0.9s var(--t-aperture) 0.2s both;
  }
  .teaser__i {
    width: 100%;
    height: 100%;
    /* dot 0–17.036%, gap to 29.302%, stem to 100%; the left edge between
       them has no width, so it draws as two separate squares */
    clip-path: polygon(0 0, 100% 0, 100% 17.036%, 0 17.036%, 0 29.302%, 100% 29.302%, 100% 100%, 0 100%);
    background: linear-gradient(165deg, #3f6bff, #9a5cff 30%, #ff3f9a 55%, #ff6a37 78%, #ff9a2e);
  }
  .teaser__i canvas { display: block; width: 100%; height: 100%; }
  @keyframes teaser-open {
    from { clip-path: inset(48% 46% 48% 46%); }
    to   { clip-path: inset(0 0 0 0); }
  }

  .teaser h1 {
    font-weight: 300;
    font-variation-settings: "opsz" 144;
    font-size: clamp(34px, 6.2vw, 72px);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .teaser .teaser__when {
    margin-top: 14px;
    color: var(--t-grey-500);
    font-weight: 300;
    font-variation-settings: "opsz" 144;
    font-size: clamp(20px, 2.6vw, 30px);
    letter-spacing: -0.02em;
  }
  .teaser__rise { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .teaser__rise > span { display: block; animation: teaser-rise 0.95s var(--t-out) 0.9s both; }
  .teaser__when.teaser__rise > span { animation-delay: 1.02s; }
  @keyframes teaser-rise { from { transform: translateY(105%); } to { transform: none; } }

  .teaser__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    flex-wrap: wrap;
    padding: 24px max(16px, env(safe-area-inset-right)) max(24px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
    animation: teaser-fade 0.8s var(--t-out) 1.4s both;
  }
  @media (min-width: 720px) { .teaser__foot { padding: 32px 48px 40px; } }
  .teaser__name { font-weight: 600; font-size: 16px; color: var(--t-grey-300); letter-spacing: -0.01em; }
  .teaser nav { display: flex; gap: 8px 24px; flex-wrap: wrap; align-items: center; }
  .teaser nav a {
    font-weight: 650;
    font-variation-settings: "opsz" 8;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .teaser nav a {
    color: var(--t-paper);
    text-decoration: none;
    padding: 8px 0;
    border-bottom: 1px solid transparent;
  }
  .teaser nav a:hover,
  .teaser nav a:focus-visible { border-bottom-color: currentColor; outline: none; }
  @keyframes teaser-fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  @media (max-width: 560px) {
    .teaser__foot { flex-direction: column; align-items: flex-start; }
    /* all four links on one line at 360px and up */
    .teaser nav { column-gap: 18px; }
  }

  /* launch: the teaser fades to the site's ink and the page reloads as the site */
  .teaser::after {
    content: "";
    position: fixed;
    inset: 0;
    background: var(--t-ink);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }
  .teaser.is-opening::after { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .teaser *,
    .teaser *::before,
    .teaser *::after { animation: none !important; }
  }
</style>

<script>
  import { prismField } from '../lib/prism-field';

  const teaser = document.getElementById('teaser');

  // the head script has already decided; only run when the teaser is showing
  if (teaser && document.documentElement.classList.contains('is-teaser')) {
    const el = teaser;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // seed 97 is the frame the launch posts were rendered from, so the page
    // opens on the colours people just saw in their feed. The lean is read
    // across the whole screen: the i is far too thin to measure it across.
    prismField(el.querySelector<HTMLCanvasElement>('.teaser__i canvas')!, {
      animate: !still,
      seed: 97,
      pointerFrame: 'viewport',
    });

    /* ---- launch ----------------------------------------------------- */
    // Checked every minute rather than one long timeout: browsers cap a
    // timeout at ~24.8 days, and a laptop that sleeps through midnight
    // should still lift the moment it wakes.
    const launchAt = Date.parse(el.dataset.at ?? '');
    let timer = 0;
    let opened = false;
    const check = () => {
      clearTimeout(timer);
      const left = launchAt - Date.now();
      if (left > 0) {
        timer = window.setTimeout(check, Math.min(left + 50, 60_000));
        return;
      }
      if (opened) return;
      opened = true;
      el.classList.add('is-opening');
      // the head script now lets the site through, and its own loader
      // takes it from there
      setTimeout(() => location.reload(), still ? 0 : 650);
    };
    check();
    document.addEventListener('visibilitychange', () => { if (!document.hidden) check(); });
  }
</script>
