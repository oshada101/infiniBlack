---
/* SERVICES — an index of five words, each a window.
 *
 * The names are set big enough to be shapes, and the same prism field the
 * hero shows through its diamond lies under the whole list. It is seen only
 * through one name at a time: hover a row (or, on a touch screen, bring it to
 * the middle of the screen) and the field pours into its letters. Moving to
 * another row slides that window across to the next word over the one
 * continuous field — the hero's rule, colour only inside a shape, with the
 * words as the shapes.
 *
 * How: the field's canvas lies over the list with mix-blend-mode: darken,
 * which keeps the darker of the two. Every colour in the field is lighter
 * than the ground, so the ground stays exactly itself; white type is lighter
 * than every colour, so the type becomes the field. A clip-path inset, moved
 * to the active name's box, decides which word that is.
 *
 * Each row is also a door. Its names are the request form's options word for
 * word (Contact.astro builds them from the same list), so picking a row opens
 * the form with that service already ticked.
 */
import { services } from '../data/site';

const diamond =
  'M 56 10.2 L 94 74.8 Q 100 85 94 95.2 L 56 159.8 Q 50 170 44 159.8 L 6 95.2 Q 0 85 6 74.8 L 44 10.2 Q 50 0 56 10.2 Z';
---

<section class="services" id="services" aria-labelledby="services-title">
  <header class="svc-head">
    <h2 class="svc-title" id="services-title">Services</h2>
  </header>

  <div class="svc-index" data-svc-index>
    <ul class="svc-list">
      {services.map((service, i) => (
        <li class="svc-row" style={`--i:${i}`} data-svc-row>
          <h3 class="svc-name">
            <button class="svc-open" type="button" data-contact-open data-help={service.title}>
              <span class="svc-name__text" data-svc-word>{service.title}</span>
              <span class="sr-only"> — make a request</span>
            </button>
          </h3>

          <div class="svc-about">
            <p class="svc-desc">{service.desc}</p>
            {/* AI's worked examples give their labels here like the others'
                tags; the longer write-ups stay in site.ts for a services page */}
            <ul class="svc-tags" aria-label="For example">
              {(service.tags ?? service.details?.map((d) => d.label) ?? []).map((tag) => <li>{tag}</li>)}
            </ul>
          </div>

          <span class="svc-go" aria-hidden="true">
            Request
            <svg viewBox="0 0 100 170" fill="currentColor"><path d={diamond} /></svg>
          </span>
        </li>
      ))}
    </ul>

    <canvas class="svc-field" aria-hidden="true" data-svc-field></canvas>
  </div>
</section>

<style>
  .services {
    padding: clamp(80px, 12vh, 140px) clamp(8px, 1.2vw, 18px) clamp(56px, 9vh, 110px);
    border-top: 1px solid rgba(255, 255, 255, .08);
    scroll-margin-top: var(--nav-h);
  }

  /* --- head -------------------------------------------------------------- */
  .svc-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 48px;
    margin-bottom: clamp(24px, 4vh, 48px);
  }
  .svc-title {
    margin: 0;
    font-size: clamp(1rem, 1.1vw, 1.1rem);
    font-weight: 650;
    font-variation-settings: 'opsz' 8;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #8a8a92;
  }

  /* --- the index --------------------------------------------------------- */
  .svc-index { position: relative; }

  .svc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid rgba(255, 255, 255, .15);
  }

  .svc-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr) auto;
    gap: 14px clamp(24px, 4vw, 64px);
    align-items: center;
    padding: clamp(14px, 2.2vh, 24px) 0;
  }
  /* the rule over each row draws itself in from the left as the row arrives —
     the site's wipe, at the width of a hairline */
  .svc-row::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: rgba(255, 255, 255, .15);
    transform-origin: left;
    transition: transform .9s cubic-bezier(.76, 0, .18, 1) calc(var(--i) * 70ms);
  }

  .svc-name { margin: 0; }

  /* the button is the row's only control; its ::after stretches over the
     whole row so the row is the target, while the name stays its label */
  .svc-open {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    color: #f2f2f2;
    font: inherit;
    font-size: clamp(2.5rem, 6.2vw, 6.6rem);
    font-weight: 450;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -.05em;
    line-height: .95;
    text-align: left;
    cursor: pointer;
  }
  .svc-open::after { content: ''; position: absolute; inset: 0; }
  .svc-open:focus-visible { outline: none; }
  .svc-row:has(.svc-open:focus-visible) { outline: 1px solid #f2f2f2; outline-offset: 6px; }

  /* inline-block so its box is the words' own width — that box is the window */
  .svc-name__text {
    display: inline-block;
    max-width: 100%;
    padding-bottom: .06em;
    text-wrap: balance;
  }

  .svc-about { display: grid; gap: 12px; }
  .svc-desc {
    margin: 0;
    max-width: 38ch;
    font-size: .98rem;
    line-height: 1.45;
    color: #8a8a92;
    text-wrap: pretty;
    transition: color .3s ease;
  }
  .svc-row.is-current .svc-desc { color: #d4d4d8; }

  /* examples as a plain run of words: they are a list, not buttons */
  .svc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5em;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: .66rem;
    font-weight: 650;
    font-variation-settings: 'opsz' 8;
    letter-spacing: .12em;
    line-height: 2;
    text-transform: uppercase;
    color: #5f5f67;
    transition: color .3s ease;
  }
  .svc-row.is-current .svc-tags { color: #8a8a92; }

  .svc-go {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: .68rem;
    font-weight: 650;
    font-variation-settings: 'opsz' 8;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #f2f2f2;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity .3s ease, transform .45s cubic-bezier(.6, 0, .2, 1);
  }
  .svc-go svg { width: 7px; height: 12px; }
  .svc-row.is-current .svc-go { opacity: 1; transform: none; }

  /* --- the field --------------------------------------------------------- */
  .svc-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    /* darken, not multiply: multiply tints the ground inside the box too,
       and the box shows as a faint rectangle round the word */
    mix-blend-mode: darken;
    opacity: 0;
    /* --t/--r/--b/--l come from the script: the active word's box */
    clip-path: inset(var(--t, 50%) var(--r, 50%) var(--b, 50%) var(--l, 50%));
    transition:
      clip-path .6s cubic-bezier(.65, 0, .2, 1),
      opacity .35s ease;
  }
  .svc-field.is-on { opacity: 1; }
  /* arriving from nothing, the window opens where it is rather than sliding
     in from wherever it last was */
  .svc-field.is-jump { transition: opacity .35s ease; }
  /* touch: masks, not the clip, decide what shows — see the script */
  .svc-field.is-scrub {
    clip-path: none;
    transition: none;
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
  }

  /* --- entrance ---------------------------------------------------------- *
   *  Armed by JS only ([data-arm] on the list), so a reader without it never
   *  sees rows waiting to arrive. */
  .svc-list[data-arm] .svc-row::before { transform: scaleX(0); }
  .svc-list[data-arm] .svc-row > :not(.svc-go) {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .7s ease, transform .9s cubic-bezier(.22, 1, .36, 1);
    transition-delay: calc(var(--i) * 70ms + 120ms);
  }
  .svc-list[data-arm] .svc-row.is-in::before { transform: scaleX(1); }
  .svc-list[data-arm] .svc-row.is-in > :not(.svc-go) { opacity: 1; transform: none; }

  /* --- narrower ---------------------------------------------------------- */
  @media (max-width: 1100px) {
    .svc-row { grid-template-columns: minmax(0, 1fr); gap: 12px; padding: clamp(18px, 2.6vh, 26px) 0; }
    .svc-go { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-row::before, .svc-go, .svc-field { transition: none; }
  }
</style>

<script>
  import { reducedMotion } from '../lib/reveal';
  import { prismField } from '../lib/prism-field';

  const index = document.querySelector<HTMLElement>('[data-svc-index]');
  const list = index?.querySelector<HTMLElement>('.svc-list');
  const canvas = index?.querySelector<HTMLCanvasElement>('[data-svc-field]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-svc-row]')];
  const still = reducedMotion();

  // A row opens the request form with its own service ticked. This listener
  // is bound before the dialog's own (this section comes first in the page),
  // so the box is set by the time the form appears.
  document.querySelectorAll<HTMLElement>('.svc-open[data-help]').forEach((button) => {
    button.addEventListener('click', () => {
      const value = button.dataset.help ?? '';
      const box = document.querySelector<HTMLInputElement>(
        `[data-help-group] input[value="${CSS.escape(value)}"]`,
      );
      if (box) box.checked = true;
    });
  });

  // --- the window ---------------------------------------------------------
  if (index && canvas) {
    const field = prismField(canvas, { animate: !still, autoplay: false, unit: window.innerHeight * 0.76 });

    /* A word's window, in the index's own coordinates, padded past the word's
       box. The tight negative tracking is subtracted after the last letter
       too, so the box stops short of that letter's right edge; descenders
       (the g in Marketing) hang below what the tight line-height gives it.
       Darken leaves the ground untouched, so a generous margin costs nothing. */
    const windowOf = (row: HTMLElement) => {
      const word = row.querySelector<HTMLElement>('[data-svc-word]')!;
      const box = index.getBoundingClientRect();
      const r = word.getBoundingClientRect();
      const em = parseFloat(getComputedStyle(word).fontSize) || 16;
      const x = r.left - box.left - em * 0.14;
      const y = r.top - box.top - em * 0.08;
      return { x, y, w: r.width + em * 0.28, h: r.height + em * 0.32, top: r.top, box };
    };

    if (window.matchMedia('(hover: hover)').matches) {
      // --- with a pointer: the window follows the hovered row -------------
      let current: HTMLElement | null = null;

      const place = () => {
        if (!current) return;
        const { x, y, w, h, box } = windowOf(current);
        canvas.style.setProperty('--t', `${y}px`);
        canvas.style.setProperty('--l', `${x}px`);
        canvas.style.setProperty('--r', `${box.width - x - w}px`);
        canvas.style.setProperty('--b', `${box.height - y - h}px`);
      };

      const setCurrent = (row: HTMLElement | null) => {
        if (row === current) return;
        const fromNothing = !current;
        rows.forEach((r) => r.classList.toggle('is-current', r === row));
        current = row;

        if (!field) return; // no WebGL: the rows still brighten, the words stay white
        if (row) {
          canvas.classList.toggle('is-jump', fromNothing);
          place();
          canvas.classList.add('is-on');
          field.start();
        } else {
          canvas.classList.remove('is-on');
          // hold the frame once it has faded, rather than drawing into nothing
          setTimeout(() => { if (!current) field.pause(); }, 400);
        }
      };

      rows.forEach((row) => {
        row.addEventListener('pointerenter', () => setCurrent(row));
        row.addEventListener('focusin', () => setCurrent(row));
        row.addEventListener('focusout', () => setCurrent(null));
        // a row can be hovered while its entrance is still moving it
        row.addEventListener('transitionend', () => { if (row === current) place(); });
      });
      index.addEventListener('pointerleave', () => setCurrent(null));

      new ResizeObserver(() => {
        canvas.classList.add('is-jump');
        place();
      }).observe(index);
    } else if (field) {
      /* --- touch: the scroll is the hand ------------------------------------
         Nothing to hover, so each name fills as it rises up the screen: the
         colour wipes in left to right — the site's wipe — between the word
         reaching 88% and 48% of the way down, and stays. By the bottom of the
         list all five are lit; scroll back and they drain again. Many windows
         at once, so this is a stack of mask layers, one per word, rather than
         the single clip the pointer version moves. */
      canvas.classList.add('is-scrub', 'is-on');
      const START = 0.88;
      const END = 0.48;
      let queued = false;
      let running = false;

      const scrub = () => {
        queued = false;
        const vh = window.innerHeight;
        const layers: { size: string; pos: string }[] = [];

        rows.forEach((row) => {
          const { x, y, w, h, top } = windowOf(row);
          const raw = (START * vh - top) / ((START - END) * vh);
          const t = Math.min(1, Math.max(0, raw));
          const p = t * t * (3 - 2 * t); // ease in and out of the wipe
          row.classList.toggle('is-current', p > 0.98);
          if (p > 0) layers.push({ size: `${w * p}px ${h}px`, pos: `${x}px ${y}px` });
        });

        if (layers.length) {
          const image = layers.map(() => 'linear-gradient(#000, #000)').join(', ');
          const size = layers.map((l) => l.size).join(', ');
          const pos = layers.map((l) => l.pos).join(', ');
          canvas.style.setProperty('mask-image', image);
          canvas.style.setProperty('-webkit-mask-image', image);
          canvas.style.setProperty('mask-size', size);
          canvas.style.setProperty('-webkit-mask-size', size);
          canvas.style.setProperty('mask-position', pos);
          canvas.style.setProperty('-webkit-mask-position', pos);
          if (!running) { field.start(); running = true; }
        } else {
          // nothing lit: an empty mask, and no frames drawn into it
          canvas.style.setProperty('mask-image', 'linear-gradient(transparent, transparent)');
          canvas.style.setProperty('-webkit-mask-image', 'linear-gradient(transparent, transparent)');
          if (running) { field.pause(); running = false; }
        }
      };

      const request = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(scrub);
      };
      window.addEventListener('scroll', request, { passive: true });
      new ResizeObserver(request).observe(index);
      rows.forEach((row) => row.addEventListener('transitionend', request));
      scrub();
    }
  }

  // --- entrance -----------------------------------------------------------
  // Rows arrive once, as each reaches the screen, and stay arrived.
  if (list && !still) {
    list.setAttribute('data-arm', '');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    rows.forEach((row) => io.observe(row));
  }
</script>
