---
import { workItems, workHref } from '../data/site';

interface Props {
  base: string;
}

const { base } = Astro.props;
---

<!-- work: featured projects -->
<section class="work pt-[clamp(80px,12vh,140px)] px-[clamp(8px,1.2vw,18px)] border-t border-[rgba(255,255,255,.08)]" id="work">
  <h2 class="section-title text-[clamp(2.2rem,5.5vw,4rem)] font-normal tracking-[-.02em] text-grey-200 pt-[clamp(20px,3vh,34px)] pb-[clamp(16px,2.5vh,28px)] border-b border-[rgba(255,255,255,.15)]">Featured Work</h2>

  <div class="work-list relative ">
    {workItems.map((item) => (
      <article class="work-item flex flex-wrap gap-[clamp(24px,3vw,48px)] py-[clamp(16px,2vh,22px)] shadow-[0_-1px_0_rgba(255,255,255,.12)]">
        {item.media.kind === 'hover-video' ? (
          <a
            class="work-item__media work-item__media--hover-video group relative flex-[1_1_55%] min-w-[280px] aspect-video flex items-center justify-center text-[rgba(255,255,255,.35)] text-[.85rem] font-medium no-underline cursor-pointer"
            href={workHref(base, item)}
          >
            <img
              class="work-item__media-img absolute inset-0 w-full h-full object-cover [transition:opacity_.2s_ease] group-hover:opacity-0"
              src={`${base}${item.media.img.src}`}
              alt={item.media.img.alt}
            />
            <video
              class="work-item__media-video absolute inset-0 w-full h-full object-cover opacity-0 [transition:opacity_.2s_ease] group-hover:opacity-100"
              src={`${base}${item.media.video.src}`}
              muted
              loop
              playsinline
              preload="metadata"
            ></video>
            <span class="work-item__tooltip absolute top-0 left-0 px-[9px] py-1 bg-[rgba(10,10,13,.8)] text-white text-[.62rem] font-semibold tracking-[.03em] whitespace-nowrap opacity-0 pointer-events-none [transition:opacity_.15s_ease] group-hover:opacity-100">[View Project]</span>
          </a>
        ) : (
          <a
            class="work-item__media group relative flex-[1_1_55%] min-w-[280px] aspect-video flex items-center justify-center text-[rgba(255,255,255,.35)] text-[.85rem] font-medium no-underline cursor-pointer"
            href={workHref(base, item)}
          >
            <img src={`${base}${item.media.img.src}`} alt={item.media.img.alt} style={item.media.img.style} />
            <span class="work-item__tooltip absolute top-0 left-0 px-[9px] py-1 bg-[rgba(10,10,13,.8)] text-white text-[.62rem] font-semibold tracking-[.03em] whitespace-nowrap opacity-0 pointer-events-none [transition:opacity_.15s_ease] group-hover:opacity-100">[View Project]</span>
          </a>
        )}
        <div class="work-item__info flex-[1_1_35%] min-w-[240px] flex flex-col justify-between gap-[clamp(24px,4vh,48px)] bg-ink">
          {/* masthead: standfirst left, name right, closed by a hairline. The
              shared bottom edge is what stops the two ragged edges reading as
              a jagged channel — same trick a newspaper nameplate uses. */}
          <div class="work-item__masthead flex justify-between items-start gap-[clamp(20px,2.6vw,52px)]">
            <p class="work-item__desc min-w-0 text-[1.15rem] font-normal leading-[1.4] text-grey-200 max-w-[30ch] text-pretty">{item.desc}</p>
            <h3 class="work-item__title flex-initial text-[clamp(1.7rem,3vw,2.6rem)] font-normal [font-variation-settings:'opsz'_40] text-white tracking-[-.015em] leading-[1.05] text-right text-balance"><a class="text-inherit no-underline hover:underline hover:[text-underline-offset:.12em]" href={workHref(base, item)}>{item.title}</a></h3>
          </div>

          <div class="work-item__foot">
            <ul class="work-item__tags list-none">
              {item.tags.map((tag) => <li class="text-[.82rem] font-semibold uppercase tracking-[.08em] text-grey-300 leading-[1.9]">{tag}</li>)}
            </ul>
          </div>
        </div>
      </article>
    ))}
    <div class="work-list__hold" aria-hidden="true"></div>
  </div>
</section>

<script>
  const workSection = document.querySelector('.work') as HTMLElement | null;
  const workTitle = workSection?.querySelector('.section-title') as HTMLElement | null;
  const workHold = workSection?.querySelector('.work-list__hold') as HTMLElement | null;
  const workCards = [...(workSection?.querySelectorAll('.work-item') ?? [])] as HTMLElement[];
  const lastCard = workCards[workCards.length - 1];

  let pin = 0;
  let titleH = 0;
  let cardH = 0;

  // keep the stacking cards pinned right below the sticky "Featured Work"
  // title — measure its height (fluid font, so it changes on resize).
  const measure = () => {
    if (!workSection || !workTitle) return;
    pin = parseFloat(getComputedStyle(workSection).getPropertyValue('--work-pin')) || 0;
    titleH = workTitle.offsetHeight;
    cardH = lastCard ? lastCard.offsetHeight : 0;
    document.documentElement.style.setProperty('--work-title-h', titleH + 'px');
  };

  /* Both the title and the cards are clamped by the bottom of their sticky
     containing block, and a taller box hits that clamp sooner — so the last
     card (a whole card tall) unpins one card-height of scroll BEFORE the
     title does, stranding "Featured Work" over dead space.

     Rather than fight the clamp, close that gap by hand: the .work-list__hold
     spacer is static, so its bottom edge is a reliable read on how far the
     stack has left to travel. Once that edge climbs past where the pinned
     title + last card end, drag the title up by the difference and the two
     exit as one. Cheaper than it looks — one rect read per frame. */
  const syncRelease = () => {
    if (!workTitle || !workHold) return;
    const overshoot = pin + titleH + cardH - workHold.getBoundingClientRect().bottom;
    workTitle.style.transform = overshoot > 0 ? `translateY(${-overshoot}px)` : '';
  };

  if (workSection && workTitle) {
    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        syncRelease();
      });
    };

    measure();
    syncRelease();
    window.addEventListener('resize', () => {
      measure();
      syncRelease();
    });
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // hover-to-play: pauses in place on mouseleave, no rewind
  document.querySelectorAll('.work-item__media--hover-video').forEach((el) => {
    const video = el.querySelector('video');
    if (!video) return;
    el.addEventListener('mouseenter', () => video.play());
    el.addEventListener('mouseleave', () => video.pause());
  });

  // tooltip follows the cursor while hovering a project's media
  document.querySelectorAll('.work-item__media').forEach((el) => {
    const tooltip = el.querySelector('.work-item__tooltip') as HTMLElement | null;
    if (!tooltip) return;
    el.addEventListener('mousemove', (e) => {
      const rect = (el as HTMLElement).getBoundingClientRect();
      const x = (e as MouseEvent).clientX - rect.left + 14;
      const y = (e as MouseEvent).clientY - rect.top + 14;
      tooltip.style.transform = `translate(${x}px, ${y}px)`;
    });
  });
</script>
