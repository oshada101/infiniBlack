---
/* WORK — the projects, one screen each.
 *
 * Each project is a panel nearly the height of the screen: the work itself,
 * as large as the page allows, and under it one row set like a Services row
 * (name, what it was, what kind, the way in). The panels stick under the nav
 * and the next one slides up over the last, so the section reads as a stack
 * being dealt rather than a list being scrolled.
 *
 * Each picture is a product shot: the project's own title card behind, and
 * one screen of the real thing rising into it from the bottom edge — brand
 * first, then proof. The section brings no colour of its own; the work
 * supplies it, which is the hero's rule seen from the other side.
 */
import { workItems, workHref } from '../data/site';

interface Props {
  base: string;
}

const { base } = Astro.props;
---

<section class="work" id="work" aria-labelledby="work-title">
  <header class="wk-head">
    <h2 class="wk-label" id="work-title">Work</h2>
  </header>

  <div class="wk-list">
    {workItems.map((item, i) => (
      <article class="wk-panel" style={`--i:${i}`}>
        <div class="wk-media">
          {item.cover.kind === 'shot' ? (
            <>
              <img class="wk-media__el" src={`${base}${item.cover.field}`} alt="" loading="lazy" decoding="async" />
              <img
                class="wk-shot"
                src={`${base}${item.cover.screen}`}
                alt={item.cover.alt}
                loading="lazy"
                decoding="async"
                style={item.cover.width ? `--shot-w:${item.cover.width}%` : undefined}
              />
            </>
          ) : (
            <img
              class="wk-media__el"
              src={`${base}${item.cover.src}`}
              alt={item.cover.alt}
              loading="lazy"
              decoding="async"
              style={item.cover.position ? `object-position:${item.cover.position}` : undefined}
            />
          )}
        </div>

        <div class="wk-info">
          {/* the name is the link; its ::after stretches over the whole panel */}
          <h3 class="wk-title"><a href={workHref(base, item)}>{item.title}</a></h3>
          <div class="wk-about">
            <p class="wk-desc">{item.desc}</p>
            <ul class="wk-tags" aria-label="Project type">
              {item.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
          <span class="wk-view" aria-hidden="true">
            View project
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 18 18 6M8.5 6H18v9.5" />
            </svg>
          </span>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .work {
    --gut: clamp(8px, 1.2vw, 18px);
    padding: clamp(80px, 12vh, 140px) var(--gut) clamp(40px, 6vh, 72px);
    border-top: 1px solid rgba(255, 255, 255, .08);
    scroll-margin-top: var(--nav-h);
  }

  .wk-head { margin-bottom: clamp(24px, 4vh, 48px); }
  .wk-label {
    margin: 0;
    font-size: clamp(1rem, 1.1vw, 1.1rem);
    font-weight: 650;
    font-variation-settings: 'opsz' 8;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #8a8a92;
  }

  /* the panels run out to <main>'s edge, past the section's own inset, so
     the work gets the full width the page has */
  .wk-list { margin: 0 calc(-1 * var(--gut)); }

  /* --- the panel ------------------------------------------------------- */
  .wk-panel {
    position: sticky;
    top: var(--nav-h);
    display: flex;
    flex-direction: column;
    /* exactly the screen under the nav, whatever its height: the picture
       takes what the row below it doesn't need */
    height: calc(100svh - var(--nav-h));
    min-height: 420px;
    background: #0a0a0d;
    /* the edge the next panel slides in on: a shadow cast up onto the one
       being covered, so the stack reads as depth and not as a cut */
    box-shadow: 0 -24px 60px rgba(0, 0, 0, .65);
  }
  /* The hold. A panel pinned under the nav is pushed down from where it
     would sit, so the next one — which has not been — starts covering its
     bottom edge, the info row, as soon as the gap between them runs out.
     With a gap of a few dozen pixels that was almost at once. A third of a
     screen gives each panel a beat at full size first. The gap itself never
     shows: it passes behind the pinned panel, which fills the screen. */
  .wk-panel + .wk-panel { margin-top: 34vh; }
  /* and the same beat for the last one, before the section lets go of it */
  .wk-list::after { content: ''; display: block; height: 34vh; }

  .wk-media {
    position: relative;
    flex: 1;
    min-height: 180px;
    overflow: hidden;
    background: #000;
  }
  .wk-media__el {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transform: scale(1.001);
    transition: transform 1.4s cubic-bezier(.22, 1, .36, 1);
  }
  .wk-panel:hover .wk-media__el { transform: scale(1.035); }

  /* the product shot: one screen rising out of the bottom edge, below the
     field's wordmark, cropped by the frame so only its top shows */
  .wk-shot {
    position: absolute;
    left: 50%;
    top: 56%;
    width: min(var(--shot-w, 74%), 1180px);
    height: auto;
    display: block;
    translate: -50% 0;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, .08),
      0 40px 120px rgba(0, 0, 0, .65);
    transition: transform 1.2s cubic-bezier(.22, 1, .36, 1);
  }
  .wk-panel:hover .wk-shot { transform: translateY(-14px); }

  /* --- the row under it ------------------------------------------------ */
  /* one row, always: name, what it was, the way in. The name never wraps —
     a two-line name is what pushed the row off the bottom of short screens */
  .wk-info {
    flex: none;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px clamp(24px, 4vw, 64px);
    padding: clamp(12px, 2.4vh, 26px) var(--gut) clamp(6px, 1.4vh, 14px);
  }

  .wk-title {
    margin: 0;
    /* sized by whichever runs out first, width or height */
    font-size: clamp(1.8rem, min(4.4vw, 7.5vh), 4.8rem);
    font-weight: 450;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -.05em;
    line-height: 1;
    white-space: nowrap;
  }
  .wk-title a { color: #f2f2f2; text-decoration: none; }
  .wk-title a::after { content: ''; position: absolute; inset: 0; }
  .wk-title a:focus-visible { outline: none; }
  .wk-panel:has(.wk-title a:focus-visible) { outline: 1px solid #f2f2f2; outline-offset: 4px; }

  .wk-desc {
    margin: 0;
    max-width: 36ch;
    font-size: .98rem;
    line-height: 1.45;
    color: #8a8a92;
    text-wrap: pretty;
    transition: color .3s ease;
  }
  .wk-panel:hover .wk-desc { color: #d4d4d8; }

  .wk-about { display: grid; gap: 6px; min-width: 0; }

  .wk-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.4em;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: .66rem;
    font-weight: 650;
    font-variation-settings: 'opsz' 8;
    letter-spacing: .12em;
    line-height: 1.8;
    text-transform: uppercase;
    color: #5f5f67;
  }

  .wk-view {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: .68rem;
    font-weight: 650;
    font-variation-settings: 'opsz' 8;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #f2f2f2;
  }
  .wk-view svg {
    width: 16px;
    height: 16px;
    transition: transform .35s cubic-bezier(.6, 0, .2, 1);
  }
  .wk-panel:hover .wk-view svg { transform: translate(3px, -3px); }

  /* --- narrower -------------------------------------------------------- */
  @media (max-width: 900px) {
    .wk-info { grid-template-columns: minmax(0, 1fr) auto; }
    .wk-about { grid-column: 1 / -1; grid-row: 2; }
  }

  @media (max-width: 640px) {
    .wk-panel { height: auto; min-height: 0; }
    /* panels here are shorter than the screen, so there is nothing to hold */
    .wk-panel + .wk-panel { margin-top: clamp(24px, 5vh, 48px); }
    .wk-list::after { display: none; }
    /* a phone frame is portrait and the work is landscape: show it whole,
       at its own shape, rather than a sliver of it cropped to the screen */
    .wk-media { flex: none; aspect-ratio: 16 / 10; }
    /* a phone frame is small: every screen a size up, keeping their ratio */
    .wk-shot { width: calc(var(--shot-w, 74%) * 1.16); top: 60%; }
    .wk-title { white-space: normal; text-wrap: balance; }
    .wk-info { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .wk-view { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wk-panel { position: relative; top: auto; }
    .wk-panel + .wk-panel { margin-top: clamp(24px, 5vh, 48px); }
    .wk-list::after { display: none; }
    .wk-media__el, .wk-shot, .wk-view svg { transition: none; }
  }
</style>

