---

<!-- ===== CURTAIN / LOADER OVERLAY ===== -->
<div class="curtain" id="curtain">
  <div class="curtain__half curtain__half--left"></div>
  <div class="curtain__half curtain__half--right"></div>
  <div class="seam seam--top"></div>
  <div class="seam seam--bottom"></div>

  <div class="loader-wrap">
    <div class="loader" role="status" aria-label="Loading">
      <svg viewBox="0 0 100 170" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <clipPath id="diamond" clipPathUnits="userSpaceOnUse">
            <path id="clipShape"
                  d="M 54 81 L 54 81 Q 58 85 54 89 L 54 89 Q 50 93 46 89 L 46 89 Q 42 85 46 81 L 46 81 Q 50 77 54 81 Z">
              <animate attributeName="d" begin="0.16s" dur="0.9s" fill="freeze"
                       calcMode="spline" keyTimes="0;1" keySplines="0.16 1 0.3 1"
                       values="M 54 81 L 54 81 Q 58 85 54 89 L 54 89 Q 50 93 46 89 L 46 89 Q 42 85 46 81 L 46 81 Q 50 77 54 81 Z;
                               M 56 10.2 L 94 74.8 Q 100 85 94 95.2 L 56 159.8 Q 50 170 44 159.8 L 6 95.2 Q 0 85 6 74.8 L 44 10.2 Q 50 0 56 10.2 Z"/>
            </path>
          </clipPath>

          <filter id="goo" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="11"/>
          </filter>

          <radialGradient id="gCoral"   cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#ff6a37" stop-opacity="1"/><stop offset="55%" stop-color="#ff6a37" stop-opacity=".85"/><stop offset="100%" stop-color="#ff6a37" stop-opacity="0"/></radialGradient>
          <radialGradient id="gOrange"  cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#ff9a2e" stop-opacity="1"/><stop offset="55%" stop-color="#ff9a2e" stop-opacity=".85"/><stop offset="100%" stop-color="#ff9a2e" stop-opacity="0"/></radialGradient>
          <radialGradient id="gPurple"  cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#9a5cff" stop-opacity="1"/><stop offset="55%" stop-color="#9a5cff" stop-opacity=".85"/><stop offset="100%" stop-color="#9a5cff" stop-opacity="0"/></radialGradient>
          <radialGradient id="gBlue"    cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#3f6bff" stop-opacity="1"/><stop offset="55%" stop-color="#3f6bff" stop-opacity=".85"/><stop offset="100%" stop-color="#3f6bff" stop-opacity="0"/></radialGradient>
          <radialGradient id="gMagenta" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#ff3f9a" stop-opacity="1"/><stop offset="55%" stop-color="#ff3f9a" stop-opacity=".85"/><stop offset="100%" stop-color="#ff3f9a" stop-opacity="0"/></radialGradient>
        </defs>

        <g clip-path="url(#diamond)" opacity="0">
          <animate attributeName="opacity" from="0" to="1" begin="0s" dur="0.2s" fill="freeze"/>
          <rect x="0" y="0" width="100" height="170" fill="#fff"/>
          <g filter="url(#goo)" opacity="0">
            <animate attributeName="opacity" from="0" to="1" begin="0.8s" dur="0.5s" fill="freeze"/>
            <circle class="blob b1" cx="50" cy="66"  r="38" fill="url(#gCoral)"/>
            <circle class="blob b2" cx="50" cy="104" r="38" fill="url(#gPurple)"/>
            <circle class="blob b3" cx="50" cy="58"  r="34" fill="url(#gBlue)"/>
            <circle class="blob b4" cx="50" cy="112" r="32" fill="url(#gMagenta)"/>
            <circle class="blob b5" cx="50" cy="85"  r="34" fill="url(#gOrange)"/>
          </g>
        </g>
      </svg>
    </div>
  </div>
</div>

<script>
  /* The curtain has to answer to what has actually loaded. `load` is the wrong
     signal: browsers hold it back until the hero video has buffered, so the
     diamond would sit there fully formed for as long as hero.mp4 took, and
     forever if it stalled. Wait on the fonts and the video's FIRST FRAME
     instead, floored so the diamond gets to finish forming and capped so a
     slow network can't hold the page hostage.

     Which element that is depends on the page — the home hero's video, a
     project page's full-screen still — so the page marks its own with
     [data-curtain-media] rather than the curtain hunting for a hero. */
  const MIN_HOLD  = 2600; // ms from navigation; the diamond finishes at ~1.3s
  const PAD       = 1000; // deliberate extra beat after everything is ready
  const MAX_HOLD  = 6000; // ms from navigation; open regardless past this
  const REVEAL_MS = 1900; // length of the CSS cut -> seam -> part sequence

  const curtain = document.getElementById('curtain');

  if (curtain) {
    const root = document.documentElement;

    // there is nothing to scroll toward behind the curtain — but don't fight a
    // deep link, whose hash the browser has already scrolled to.
    const locks = !window.location.hash;
    if (locks) root.classList.add('is-loading');

    let revealed = false;

    // .reveal drives the CSS sequence via transition-delays:
    //   cut (fluid dissolves, hole opens) 0s -> seam draws .28s -> curtains part .95s
    const reveal = () => {
      if (revealed) return;
      revealed = true;
      curtain.classList.add('reveal');
      root.classList.remove('is-loading');
      setTimeout(() => curtain.remove(), REVEAL_MS);
    };

    // performance.now() counts from navigation, which is also when the SVG's
    // own animations started — so the floor is measured on the same clock.
    const holdFor = (ms: number) => setTimeout(reveal, Math.max(0, ms - performance.now()));

    const ready: Promise<unknown>[] = [];

    // let the display font swap in behind the curtain, not under the reader
    if (document.fonts) ready.push(document.fonts.ready);

    // a video only needs one frame to paint; waiting on the whole file is what
    // made this feel stuck. A dead src settles too — it must not trap anyone.
    const media = document.querySelector<HTMLElement>('[data-curtain-media]');
    const painted =
      media instanceof HTMLVideoElement
        ? media.readyState >= 2 /* HAVE_CURRENT_DATA */
        : media instanceof HTMLImageElement
          ? media.complete
          : true;

    if (media && !painted) {
      ready.push(
        new Promise<void>((settle) => {
          const done = () => settle();
          media.addEventListener(media instanceof HTMLVideoElement ? 'loadeddata' : 'load', done, { once: true });
          media.addEventListener('error', done, { once: true });
        }),
      );
    }

    // even on a warm cache the curtain sits for a beat past ready: the floor
    // covers the instant case, PAD covers everything after it. MAX_HOLD still
    // wins — past six seconds nobody wants another second of ceremony.
    Promise.all(ready).then(() =>
      holdFor(Math.min(MAX_HOLD, Math.max(MIN_HOLD, performance.now() + PAD))),
    );
    holdFor(MAX_HOLD);
  }
</script>
