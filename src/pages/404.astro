---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="404 — Infiniblack" description="Page not found.">
  <main class="notfound">
    <p class="notfound__code">Error 404</p>
    <h1 class="notfound__title">Page not found</h1>
    <p class="notfound__body">Nothing built here yet. The path you followed doesn't exist.</p>
    <a class="notfound__link" href={base}>Back to home</a>
  </main>
</Layout>

<style>
  .notfound {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1rem;
    padding: clamp(24px, 8vw, 96px);
    background: #0a0a0d;
    color: #fff;
  }
  .notfound__code {
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ff5a2a;
  }
  .notfound__title {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1;
    color: #f2f2f2;
  }
  .notfound__body {
    max-width: 40ch;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.4;
  }
  .notfound__link {
    margin-top: 1rem;
    padding: 0.7rem 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: border-color 0.25s ease, color 0.25s ease;
  }
  .notfound__link:hover {
    border-color: #ff5a2a;
    color: #ff5a2a;
  }
</style>
