---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="404 — Infiniblack" description="Page not found.">
  <main class="notfound min-h-screen flex flex-col items-start justify-center gap-4 p-[clamp(24px,8vw,96px)] bg-ink text-white">
    <p class="notfound__code text-[.82rem] font-semibold uppercase tracking-[.08em] text-accent">Error 404</p>
    <h1 class="notfound__title text-[clamp(2.5rem,8vw,5rem)] font-normal tracking-[-.025em] leading-none text-[#f2f2f2]">Page not found</h1>
    <p class="notfound__body max-w-[40ch] text-[rgba(255,255,255,.6)] leading-[1.4]">Nothing built here yet. The path you followed doesn't exist.</p>
    <a
      class="notfound__link mt-4 py-[.7rem] px-[1.4rem] border border-[rgba(255,255,255,.25)] text-white no-underline text-[.82rem] font-semibold uppercase tracking-[.06em] [transition:border-color_.25s_ease,color_.25s_ease] hover:border-accent hover:text-accent"
      href={base}
      >Back to home</a
    >
  </main>
</Layout>
