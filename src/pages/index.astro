---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Work from '../components/Work.astro';
import Contact from '../components/Contact.astro';
import Loader from '../components/Loader.astro';

const base = import.meta.env.BASE_URL;
---

<Layout>
  <!-- ===== PAGE ===== -->
  <main class="page relative min-h-screen flex flex-col text-white bg-ink">
    <Nav base={base} />
    <Hero base={base} />
    <Services />
    <Work base={base} />
    <Contact />
  </main>

  <Loader />
</Layout>

<script>
  // nav is solid over the hero video, transparent once scrolled past it
  const nav = document.querySelector('.nav');
  const heroMedia = document.querySelector('.hero-media');
  if (nav && heroMedia) {
    const syncNav = () => {
      // switch when the video is nearly scrolled out (leave the nav's own height)
      const threshold = (heroMedia as HTMLElement).offsetHeight - (nav as HTMLElement).offsetHeight;
      nav.classList.toggle('is-transparent', window.scrollY > threshold);
    };
    syncNav();
    window.addEventListener('scroll', syncNav, { passive: true });
    window.addEventListener('resize', syncNav);
  }

  // scrollspy: highlight the nav link for the section currently in view
  // must stay in document order — the loop below takes the last section
  // whose top has crossed the line.
  //
  // Every link to a section is collected, not just the bar's: below 860px the
  // same four destinations exist a second time inside the mobile panel, and
  // one of the two saying "you are here" while the other doesn't is worse
  // than neither saying it. Selecting on href rather than on position also
  // means "Contact Us" needs no special case for living in .nav__right.
  const spySections = [
    { el: document.querySelector('.hero'), hash: '#' },
    { el: document.querySelector('#services'), hash: '#services' },
    { el: document.querySelector('#work'), hash: '#work' },
    { el: document.querySelector('#contact'), hash: '#contact' },
  ]
    .map((s) => ({ el: s.el, links: [...document.querySelectorAll(`.nav a[href="${s.hash}"]`)] }))
    .filter((s) => s.el && s.links.length) as { el: Element; links: Element[] }[];

  if (spySections.length) {
    const setActive = (current: { links: Element[] }) => {
      spySections.forEach((s) => s.links.forEach((l) => l.classList.toggle('is-active', s === current)));
    };
    const syncSpy = () => {
      // the section crossing just below the nav is the active one
      const line = (nav ? (nav as HTMLElement).offsetHeight : 36) + 1;
      let current = spySections[0];
      for (const s of spySections) {
        if (s.el.getBoundingClientRect().top <= line) current = s;
      }
      setActive(current);
    };
    syncSpy();
    window.addEventListener('scroll', syncSpy, { passive: true });
    window.addEventListener('resize', syncSpy);
  }
</script>
