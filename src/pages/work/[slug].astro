---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Loader from '../../components/Loader.astro';
import ProjectShot from '../../components/ProjectShot.astro';
import { workItems, workHref, type WorkGalleryItem } from '../../data/site';

export function getStaticPaths() {
  return workItems.map((item, i) => ({
    params: { slug: item.slug },
    props: { item, next: workItems[(i + 1) % workItems.length] },
  }));
}

const { item, next } = Astro.props;
const base = import.meta.env.BASE_URL;

/* Moving pictures first, then stills — sorted rather than trusted to the
   data, and Array.sort is stable, so the rest keep their written order.

   Then paced: the first piece runs full width, and the stills after it pair
   up side by side, so the gallery has a rhythm instead of one screenshot
   after another at the same size. A video always gets a row of its own, and
   an odd still out at the end goes full width rather than sitting half
   empty. */
const ordered = [...item.gallery].sort(
  (a, b) => Number(b.kind === 'video') - Number(a.kind === 'video'),
);
const rows: WorkGalleryItem[][] = [];
ordered.forEach((media, i) => {
  const last = rows[rows.length - 1];
  const pairable = i > 0 && media.kind === 'image';
  if (pairable && last && last.length === 1 && last[0].kind === 'image' && rows.length > 1) {
    last.push(media);
  } else {
    rows.push([media]);
  }
});
---

<Layout title={`${item.title} — infiniblack`} description={item.desc} ground="black">
  <main class="page relative min-h-screen flex flex-col text-white bg-black">
    <Nav base={base} home={base} active="work" />

    {/* THE OPENING. The same picture the homepage panel showed — title card,
        screen rising into it — now filling the screen, so the click reads as
        the panel growing rather than a new page starting. Scrolling lifts
        the screen to the centre over the wordmark (see .project-stage), then
        the frame lets go and the write-up is directly behind it. */}
    <section class="project-stage relative w-full">
      <div class="project-stage__frame">
        <div class="project-stage__art">
          <ProjectShot cover={item.cover} base={base} curtain eager />
        </div>
      </div>
    </section>

    <div class="pj">
      {/* --- the account of the job ------------------------------------- */}
      <section class="pj-info" data-pj-info>
        <p class="pj-label pj-reveal" style="--i:0">Project</p>
        <h1 class="pj-title pj-reveal" style="--i:1">{item.title}</h1>
        <p class="pj-lead pj-reveal" style="--i:2">{item.desc}</p>

        <div class="pj-body">
          <div class="pj-copy pj-reveal" style="--i:3">
            {item.body.map((para) => <p>{para}</p>)}

            <h2 class="pj-label pj-label--sub">{item.delivered.heading}</h2>
            <ul class="pj-list">
              {item.delivered.items.map((line) => (
                <li><span class="pj-list__mark" aria-hidden="true"></span>{line}</li>
              ))}
            </ul>
          </div>

          <aside class="pj-facts pj-reveal" style="--i:4" aria-label="Project facts">
            <dl>
              {item.meta.map((entry) => (
                <div class="pj-fact">
                  <dt>{entry.label}</dt>
                  <dd>{entry.value}</dd>
                </div>
              ))}
            </dl>
            {item.url && (
              <a class="pj-visit" href={item.url} target="_blank" rel="noopener noreferrer">
                Visit the live site
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 18 18 6M8.5 6H18v9.5" />
                </svg>
              </a>
            )}
          </aside>
        </div>
      </section>

      {/* --- the work itself -------------------------------------------- */}
      {rows.length > 0 && (
        <section class="pj-gallery" aria-label={`${item.title} — gallery`}>
          {rows.map((row) => (
            <div class:list={['pj-row', { 'pj-row--pair': row.length > 1 }]}>
              {row.map((media) => (
                <figure class="pj-figure">
                  <div class="pj-figure__frame">
                    {media.kind === 'video' ? (
                      <video
                        class="pj-figure__media"
                        src={`${base}${media.src}`}
                        poster={media.poster ? `${base}${media.poster}` : undefined}
                        muted
                        loop
                        playsinline
                        preload="metadata"
                      ></video>
                    ) : (
                      <img class="pj-figure__media" src={`${base}${media.src}`} alt={media.alt} loading="lazy" decoding="async" />
                    )}
                  </div>
                  {media.caption && <figcaption>{media.caption}</figcaption>}
                </figure>
              ))}
            </div>
          ))}
        </section>
      )}

      {/* --- the way on, not a dead end ----------------------------------- */}
      <section class="pj-end">
        <a class="pj-next" href={workHref(base, next)}>
          <span class="pj-label">Next project</span>
          <span class="pj-next__media">
            <ProjectShot cover={next.cover} base={base} />
          </span>
          <span class="pj-next__row">
            <span class="pj-next__title">{next.title}</span>
            <span class="pj-next__go" aria-hidden="true">
              View project
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 18 18 6M8.5 6H18v9.5" />
              </svg>
            </span>
          </span>
        </a>

        <div class="pj-cta">
          <p class="pj-cta__line">Tell us what you’re building.</p>
          <div class="pj-cta__actions">
            {/* /#request opens the form on the homepage — see Contact.astro */}
            <a class="cta cta--lg" href={`${base}#request`}>
              Make a request
              <svg class="cta__mark" viewBox="0 0 100 170" fill="currentColor" aria-hidden="true">
                <path d="M 56 10.2 L 94 74.8 Q 100 85 94 95.2 L 56 159.8 Q 50 170 44 159.8 L 6 95.2 Q 0 85 6 74.8 L 44 10.2 Q 50 0 56 10.2 Z" />
              </svg>
            </a>
            <a class="pj-back" href={`${base}#work`}>&larr; All work</a>
          </div>
        </div>

        <div class="pj-foot">
          <p>© {new Date().getFullYear()} infiniblack</p>
          <a href="#">Back to top <span aria-hidden="true">↑</span></a>
        </div>
      </section>
    </div>
  </main>

  <Loader />
</Layout>

<style>
  .pj {
    --gut: clamp(16px, 2.4vw, 36px);
    width: min(100%, 1360px);
    margin-inline: auto;
    padding: 0 var(--gut);
  }

  /* --- labels: the small uppercase voice the homepage uses ---------------- */
  .pj-label {
    display: block;
    margin: 0;
    font-size: .72rem;
    font-weight: 650;
    font-variation-settings: 'opsz' 8;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #8a8a92;
  }

  /* --- the account -------------------------------------------------------- */
  .pj-info { padding: clamp(40px, 8vh, 96px) 0 clamp(48px, 8vh, 96px); }

  .pj-title {
    margin: clamp(14px, 2vh, 22px) 0 0;
    font-size: clamp(2.6rem, 7vw, 7.4rem);
    font-weight: 450;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -.05em;
    line-height: .95;
    text-wrap: balance;
  }
  .pj-lead {
    margin: clamp(16px, 2.6vh, 28px) 0 0;
    max-width: 40ch;
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    line-height: 1.35;
    color: #d4d4d8;
    text-wrap: pretty;
  }

  .pj-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
    gap: clamp(32px, 7vw, 120px);
    margin-top: clamp(40px, 7vh, 80px);
    padding-top: clamp(28px, 4vh, 40px);
    border-top: 1px solid rgba(255, 255, 255, .15);
  }

  .pj-copy { max-width: 62ch; }
  .pj-copy p {
    margin: 0 0 1.1em;
    font-size: clamp(1.02rem, 1.15vw, 1.14rem);
    line-height: 1.6;
    color: #c7c7cc;
    text-wrap: pretty;
  }

  .pj-label--sub { margin-top: clamp(28px, 4vh, 44px); }

  .pj-list {
    display: grid;
    gap: 10px;
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
  }
  .pj-list li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: clamp(1rem, 1.1vw, 1.1rem);
    color: #f2f2f2;
  }
  .pj-list__mark {
    flex: none;
    width: 6px;
    height: 10px;
    background: currentColor;
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
    translate: 0 1px;
  }

  .pj-facts dl { margin: 0; }
  .pj-fact {
    padding: 14px 0;
    border-bottom: 1px solid rgba(255, 255, 255, .1);
  }
  .pj-fact:first-child { padding-top: 0; }
  .pj-fact dt {
    font-size: .66rem;
    font-weight: 650;
    font-variation-settings: 'opsz' 8;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #8a8a92;
  }
  .pj-fact dd {
    margin: 6px 0 0;
    font-size: 1.02rem;
    line-height: 1.35;
    color: #f2f2f2;
  }

  .pj-visit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-size: 1rem;
    color: #f2f2f2;
    text-decoration: none;
  }
  .pj-visit:hover { text-decoration: underline; text-underline-offset: .2em; }
  .pj-visit svg { width: 16px; height: 16px; transition: transform .35s cubic-bezier(.6, 0, .2, 1); }
  .pj-visit:hover svg { transform: translate(3px, -3px); }

  /* the write-up arrives on the wipe, once, as it comes into view. Gated on
     [data-reveal], which only the script sets — no script, no clip. */
  .pj-info[data-reveal] .pj-reveal {
    clip-path: inset(0 100% 0 0);
    transition: clip-path .8s cubic-bezier(.76, 0, .18, 1) calc(var(--i, 0) * 100ms);
  }
  .pj-info[data-reveal].is-in .pj-reveal { clip-path: inset(0 -2% 0 0); }

  /* --- the gallery -------------------------------------------------------- */
  .pj-gallery {
    display: grid;
    gap: clamp(40px, 8vh, 96px);
    padding-bottom: clamp(64px, 12vh, 140px);
  }
  .pj-row { display: grid; gap: clamp(16px, 2vw, 28px); }
  .pj-row--pair { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }

  .pj-figure { margin: 0; }
  /* each piece at its own proportions — a screenshot cropped to fit is a
     screenshot lying */
  .pj-figure__frame {
    border: 1px solid rgba(255, 255, 255, .1);
    background: #0a0a0d;
  }
  .pj-figure__media { display: block; width: 100%; height: auto; }
  .pj-figure figcaption {
    margin-top: 12px;
    max-width: 60ch;
    font-size: .9rem;
    line-height: 1.45;
    color: #8a8a92;
    text-wrap: pretty;
  }

  /* --- the end ------------------------------------------------------------ */
  .pj-end {
    padding-top: clamp(40px, 7vh, 80px);
    border-top: 1px solid rgba(255, 255, 255, .15);
  }

  .pj-next {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .pj-next__media {
    position: relative;
    display: block;
    margin-top: 16px;
    aspect-ratio: 21 / 9;
    overflow: hidden;
  }
  .pj-next:hover :global(.shot__field) { transform: scale(1.035); }
  .pj-next:hover :global(.shot__screen) { transform: translateY(-12px); }

  .pj-next__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding-top: clamp(14px, 2.4vh, 24px);
  }
  .pj-next__title {
    font-size: clamp(2rem, 4.6vw, 4.6rem);
    font-weight: 450;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -.05em;
    line-height: 1;
    color: #f2f2f2;
  }
  .pj-next__go {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: .68rem;
    font-weight: 650;
    font-variation-settings: 'opsz' 8;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #f2f2f2;
  }
  .pj-next__go svg { width: 16px; height: 16px; transition: transform .35s cubic-bezier(.6, 0, .2, 1); }
  .pj-next:hover .pj-next__go svg { transform: translate(3px, -3px); }
  .pj-next:focus-visible { outline: 1px solid #f2f2f2; outline-offset: 6px; }

  .pj-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
    margin-top: clamp(64px, 12vh, 140px);
    padding: clamp(28px, 4vh, 44px) 0;
    border-top: 1px solid rgba(255, 255, 255, .15);
  }
  .pj-cta__line {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(2.2rem, 5vw, 5rem);
    font-weight: 450;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -.05em;
    line-height: .95;
    color: #f2f2f2;
  }
  .pj-cta__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 32px; }
  .pj-back {
    font-size: .72rem;
    font-weight: 650;
    font-variation-settings: 'opsz' 8;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #8a8a92;
    text-decoration: none;
  }
  .pj-back:hover { color: #f2f2f2; }

  .pj-foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: clamp(14px, 2.2vh, 20px) 0 clamp(18px, 2.6vh, 28px);
    border-top: 1px solid rgba(255, 255, 255, .15);
    font-size: .78rem;
    font-weight: 500;
    letter-spacing: .02em;
    color: #8a8a92;
  }
  .pj-foot p { margin: 0; }
  .pj-foot a { color: inherit; text-decoration: none; }
  .pj-foot a:hover { color: #f2f2f2; }

  /* --- narrower ----------------------------------------------------------- */
  @media (max-width: 860px) {
    .pj-body { grid-template-columns: minmax(0, 1fr); }
    .pj-facts { order: -1; }
    .pj-facts dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20px; }
    .pj-fact:first-child { padding-top: 14px; }
    .pj-row--pair { grid-template-columns: minmax(0, 1fr); }
    .pj-next__media { aspect-ratio: 16 / 10; --shot-k: 1.16; }
    .pj-next__media :global(.shot__screen) { top: 60%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pj-info[data-reveal] .pj-reveal { clip-path: none; transition: none; }
  }
</style>

<script>
  /* THE STAGE, for phones and for browsers without scroll-driven
     animations — everywhere else the lift is a CSS scroll timeline (see
     .project-stage in global.css), which runs on the compositor and stays
     locked to the pinned frame. This is the same idea done by hand: --p tied
     to scroll POSITION, so it stops when you do. */

  // easeInOutSine, the same curve the stylesheet gives the composited path
  const ease = (t: number) => -(Math.cos(Math.PI * t) - 1) / 2;

  const stage = document.querySelector<HTMLElement>('.project-stage');
  const frame = document.querySelector<HTMLElement>('.project-stage__frame');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const composited = CSS.supports('animation-timeline: view()');
  const phone = window.matchMedia('(max-width: 640px)');

  if (stage && frame && !still) {
    let last = -1;

    /* Two mappings from scroll to --p:
       - pinned (wider screens, only where there is no scroll timeline):
         progress through the stretch the frame is held for;
       - phone (always — there is no pin to ride there): progress through
         the first 55% of the box's own height, from the top of the page, so
         the screen has settled by the time most of the box has gone. */
    const progress = () => {
      if (phone.matches) {
        return window.scrollY / Math.max(1, frame.offsetHeight * 0.55);
      }
      const pin = parseFloat(getComputedStyle(stage).getPropertyValue('--project-pin')) || 0;
      const travel = Math.max(1, stage.offsetHeight - frame.offsetHeight);
      return (pin - stage.getBoundingClientRect().top) / travel;
    };

    const sync = () => {
      if (!phone.matches && composited) return; // the stylesheet has it
      const t = Math.min(1, Math.max(0, progress()));
      const p = Math.round(ease(t) * 1000) / 1000;
      if (p === last) return;
      last = p;
      stage.style.setProperty('--p', String(p));
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        sync();
      });
    };

    sync();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      last = -1;
      sync();
    });
  }

  // the write-up wipes in once, as it comes into view
  const info = document.querySelector('[data-pj-info]');
  if (info && !still) {
    info.setAttribute('data-reveal', '');
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          obs.unobserve(entry.target);
        });
      },
      { threshold: 0.1 },
    );
    io.observe(info);
  }

  /* Gallery videos run only while they are on screen — off screen they are
     bandwidth and battery spent on something nobody is looking at. */
  const clips = document.querySelectorAll<HTMLVideoElement>('.pj-gallery video');
  if (clips.length && !still) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const clip = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) clip.play().catch(() => {});
          else clip.pause();
        });
      },
      { threshold: 0.25 },
    );
    clips.forEach((clip) => io.observe(clip));
  }
</script>
