---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Loader from '../../components/Loader.astro';
import { workItems, workPhases } from '../../data/site';

export function getStaticPaths() {
  return workItems.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const base = import.meta.env.BASE_URL;
const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout title={`${item.title} — infiniblack`} description={item.desc}>
  <main class="page relative min-h-screen flex flex-col text-white bg-ink">
    <Nav base={base} home={base} active="work" />

    {/* The nav, then the work — the same frame you clicked, at the size the
        card was only ever standing in for. It stays pinned there while the
        scroll takes it down in two beats (see .project-stage), then lets go
        and leaves, and the write-up is what's behind it. */}
    <section class="project-stage relative w-full mt-9">
      <div class="project-stage__frame">
        <img
          class="project-stage__img"
          src={`${base}${item.media.img.src}`}
          alt={item.media.img.alt}
          data-curtain-media
        />
      </div>
    </section>

    {/* the card's own caption, restated after the sequence so the page isn't
        a picture with no name on it */}
    <section class="project-info px-[clamp(8px,1.2vw,18px)] py-[clamp(28px,5vh,64px)]">
      <div class="project-reveal flex flex-wrap justify-between items-start gap-[clamp(20px,2.6vw,52px)] pb-[clamp(20px,3vh,34px)] border-b border-[rgba(255,255,255,.15)]" style="--i:0">
        <h1 class="text-[clamp(2.2rem,5.5vw,4rem)] font-normal tracking-[-.02em] leading-[1.05] text-white text-balance">{item.title}</h1>
        <p class="min-w-0 max-w-[38ch] text-[1.15rem] font-normal leading-[1.4] text-grey-200 text-pretty">{item.desc}</p>
      </div>

      <div class="project-reveal flex flex-wrap justify-between items-start gap-[clamp(20px,2.6vw,52px)] pt-[clamp(16px,2.5vh,28px)]" style="--i:1">
        <ul class="list-none">
          {item.tags.map((tag) => <li class="text-[.82rem] font-semibold uppercase tracking-[.08em] text-grey-300 leading-[1.9]">{tag}</li>)}
        </ul>

        <div class="work-item__phase min-w-[240px]" aria-label={`${item.statusLabel} — phase ${item.phase} of ${workPhases.length}`}>
          <ol class="work-item__phase-track list-none">
            {workPhases.map((phase, i) => (
              <li class={`work-item__phase-seg${i < item.phase ? ' is-done' : ''}`} style={`--i:${i}`} title={phase}></li>
            ))}
          </ol>
          <p class="work-item__phase-meta">
            <span class="work-item__phase-now">{item.statusLabel}</span>
            <span class="work-item__phase-count">{pad(item.phase)} / {pad(workPhases.length)}</span>
          </p>
        </div>
      </div>

      <a class="project-reveal inline-block mt-[clamp(28px,5vh,56px)] text-[.82rem] font-semibold uppercase tracking-[.08em] text-grey-300 no-underline hover:text-white" style="--i:2" href={`${base}#work`}>&larr; All work</a>
    </section>
  </main>

  <Loader />
</Layout>

<script>
  /* THE STAGE — the image comes down in two beats as you scroll.

     The sizes are tied to scroll RANGES, not to scroll position: between two
     keys of the same size nothing happens however far you scroll, which is
     what makes 70% and 40% read as stops the sequence arrives at rather than
     values it passes through on the way to small. Each drop is short and
     eased, so it lands rather than drifts.

     Past the last key the size simply holds, and the pin releases when the
     stage runs out — the image leaves as any other section would. */
  const KEYS: [at: number, scale: number][] = [
    [0.00, 1.0],  // arrives full screen, and holds there
    [0.20, 1.0],
    [0.32, 0.7],  // first drop
    [0.55, 0.7],  // holds
    [0.67, 0.4],  // second drop
    [1.00, 0.4],  // holds, then the pin lets go
  ];

  const easeInOut = (t: number) => (t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2);

  const scaleAt = (p: number) => {
    if (p <= KEYS[0][0]) return KEYS[0][1];
    for (let i = 1; i < KEYS.length; i++) {
      const [from, a] = KEYS[i - 1];
      const [to, b] = KEYS[i];
      if (p > to) continue;
      return a === b ? a : a + (b - a) * easeInOut((p - from) / (to - from));
    }
    return KEYS[KEYS.length - 1][1];
  };

  const stage = document.querySelector<HTMLElement>('.project-stage');
  const frame = document.querySelector<HTMLElement>('.project-stage__frame');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stage && frame && !still) {
    let pin = 0;
    let travel = 0;
    let last = -1;

    // how much scroll the sequence has to play in: everything the stage is
    // taller than the screen it pins to. Re-read on resize — both terms are
    // viewport units.
    const measure = () => {
      pin = parseFloat(getComputedStyle(stage).getPropertyValue('--project-pin')) || 0;
      travel = Math.max(1, stage.offsetHeight - frame.offsetHeight);
    };

    const sync = () => {
      // distance travelled since the frame pinned, as a fraction of the whole
      const p = Math.min(1, Math.max(0, (pin - stage.getBoundingClientRect().top) / travel));
      const scale = Math.round(scaleAt(p) * 1000) / 1000;
      if (scale === last) return;             // most frames of a hold change nothing
      last = scale;
      stage.style.setProperty('--project-scale', String(scale));
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        sync();
      });
    };

    measure();
    sync();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      sync();
    });
  }

  // the write-up arrives on the same cue as the phase track under it: once
  // the block itself is in view, which by then is a screen past the image.
  const info = document.querySelector('.project-info');
  const phase = document.querySelector('.work-item__phase');

  const revealOn = (el: Element | null, cls: string, threshold: number) => {
    if (!el) return;
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add(cls);
          obs.unobserve(entry.target);
        });
      },
      { threshold },
    );
    io.observe(el);
  };

  revealOn(info, 'is-in', 0.1);
  revealOn(phase, 'is-in-view', 0.6);
</script>
