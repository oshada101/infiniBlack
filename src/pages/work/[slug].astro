---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Loader from '../../components/Loader.astro';
import { workItems } from '../../data/site';

export function getStaticPaths() {
  return workItems.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const base = import.meta.env.BASE_URL;

/* Moving pictures first, then stills. Sorting rather than trusting the order
   in the data means the rule holds however the list is edited later — and
   Array.sort is stable, so everything else keeps the order it was written
   in. */
const gallery = [...item.gallery].sort(
  (a, b) => Number(b.kind === 'video') - Number(a.kind === 'video'),
);
---

<Layout title={`${item.title} — infiniblack`} description={item.desc} ground="black">
  <main class="page relative min-h-screen flex flex-col text-white bg-black">
    <Nav base={base} home={base} active="work" />

    {/* The nav, then the work — the same frame you clicked, at the size the
        card was only ever standing in for. It stays pinned there while the
        scroll takes it down in two beats (see .project-stage), then lets go
        and leaves, and the write-up is what's behind it. */}
    <section class="project-stage relative w-full mt-9">
      <div class="project-stage__frame">
        <img
          class="project-stage__img"
          src={`${base}${item.media.img.src}`}
          alt={item.media.img.alt}
          data-curtain-media
        />
      </div>
    </section>

    {/* the account of the job, once the image has finished coming down */}
    <section class="project-info px-[clamp(8px,1.2vw,18px)] py-[clamp(28px,5vh,64px)]">
      <div class="project-info__col">
        <h1 class="project-reveal text-[clamp(2.2rem,5.5vw,4rem)] font-normal tracking-[-.02em] leading-[1.05] text-white text-balance pb-[clamp(24px,4vh,52px)]" style="--i:0">{item.title}</h1>

        <div class="project-info__grid" style={`--meta-cols:${item.meta.length}`}>
          <div class="project-copy project-reveal" style="--i:1">
            {item.body.map((para) => <p>{para}</p>)}

            <p class="project-copy__heading">{item.delivered.heading}</p>
            <ul class="project-copy__list">
              {item.delivered.items.map((line) => <li>{line}</li>)}
            </ul>
          </div>

          {item.meta.map((entry, i) => (
            <div class="project-meta project-reveal" style={`--i:${i + 2}`}>
              <p class="project-meta__label">{entry.label}</p>
              <p class="project-meta__value">{entry.value}</p>
            </div>
          ))}
        </div>

        <a class="project-reveal inline-block mt-[clamp(40px,7vh,88px)] text-[.82rem] font-semibold uppercase tracking-[.08em] text-grey-300 no-underline hover:text-white" style={`--i:${item.meta.length + 2}`} href={`${base}#work`}>&larr; All work</a>
      </div>
    </section>

    {/* the work itself, one piece after another and nothing between them.
        Each frame carries the corner dots the featured-work cards wear, so
        a project's pictures are recognisably from the same site as the card
        that sent you here. */}
    {gallery.length > 0 && (
      <section class="project-gallery" aria-label={`${item.title} — gallery`}>
        {gallery.map((media) =>
          media.kind === 'video' ? (
            <figure class="project-gallery__item">
              <video
                class="project-gallery__media"
                src={`${base}${media.src}`}
                poster={media.poster ? `${base}${media.poster}` : undefined}
                muted
                loop
                playsinline
                preload="metadata"
              ></video>
            </figure>
          ) : (
            <figure class="project-gallery__item">
              <img class="project-gallery__media" src={`${base}${media.src}`} alt={media.alt} loading="lazy" decoding="async" />
            </figure>
          ),
        )}
      </section>
    )}
  </main>

  <Loader />
</Layout>

<script>
  /* THE STAGE, for browsers without scroll-driven animations — everywhere
     else the shrink is a CSS scroll timeline (see .project-stage in
     global.css), which runs on the compositor and stays locked to the
     pinned frame. This is the same mapping done by hand: size tied to
     scroll POSITION, so it stops when you do. It cannot be as smooth — a
     transform written from the main thread lands a frame after the scroll
     it answers to — so it only runs when there is nothing better. */
  const FROM = 1;    // full screen, where it arrives
  const TO = 0.6;    // the floor, where the pin lets go — matches the
                     // project-shrink keyframe in global.css

  /* easeInOutSine, the same curve the stylesheet gives the composited path.
     It has to be duplicated here rather than shared: the CSS side is a
     timing function on a scroll timeline, which is not a value this side can
     read back or apply. Keep the two in step — a browser on the fallback
     should get the same move, only a frame later, not a different one. */
  const ease = (t: number) => -(Math.cos(Math.PI * t) - 1) / 2;

  const stage = document.querySelector<HTMLElement>('.project-stage');
  const frame = document.querySelector<HTMLElement>('.project-stage__frame');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const composited = CSS.supports('animation-timeline: view()');

  if (stage && frame && !still && !composited) {
    let pin = 0;
    let travel = 0;
    let last = -1;

    // how much scroll the sequence has to play in: everything the stage is
    // taller than the screen it pins to. Re-read on resize — both terms are
    // viewport units.
    const measure = () => {
      pin = parseFloat(getComputedStyle(stage).getPropertyValue('--project-pin')) || 0;
      travel = Math.max(1, stage.offsetHeight - frame.offsetHeight);
    };

    const sync = () => {
      // distance travelled since the frame pinned, as a fraction of the whole
      const p = Math.min(1, Math.max(0, (pin - stage.getBoundingClientRect().top) / travel));
      const scale = Math.round((FROM + (TO - FROM) * ease(p)) * 1000) / 1000;
      if (scale === last) return;             // nothing to write once it's at the floor
      last = scale;
      stage.style.setProperty('--project-scale', String(scale));
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        sync();
      });
    };

    measure();
    sync();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      sync();
    });
  }

  // the write-up wipes in once the block is in view, which by then is a
  // screen past the image. Once only — it is a reveal, not a behaviour.
  const info = document.querySelector('.project-info');

  if (info) {
    // opt in to the clipped start state only now that something is here to
    // take it off again (see .project-info[data-reveal] in global.css)
    info.setAttribute('data-reveal', '');

    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          obs.unobserve(entry.target);
        });
      },
      { threshold: 0.1 },
    );
    io.observe(info);
  }

  /* Gallery videos run only while they are on screen. Off screen they are
     bandwidth and battery spent on something nobody is looking at, and a
     stack of them all decoding at once is what makes a page like this
     stutter. Kept observed — unlike a reveal, this has to work every time
     the video comes back. */
  const clips = document.querySelectorAll<HTMLVideoElement>('.project-gallery video');
  if (clips.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const clip = entry.target as HTMLVideoElement;
          // play() rejects if the element is pulled off screen mid-promise;
          // that is not an error worth surfacing
          if (entry.isIntersecting) clip.play().catch(() => {});
          else clip.pause();
        });
      },
      { threshold: 0.25 },
    );
    clips.forEach((clip) => io.observe(clip));
  }
</script>
