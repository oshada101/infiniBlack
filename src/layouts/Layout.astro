---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** the page's ground. Ink everywhere the site has chrome on it; true
      black where the work itself is the page and anything lighter than the
      image's own black would show as a seam around it. */
  ground?: 'ink' | 'black';
}

const {
  title = 'Infiniblack — a product engineering studio',
  description =
    'infiniblack is a product engineering studio. AI systems and complete web, mobile, and desktop products, designed by one team and engineered for the years they will actually run.',
  ground = 'ink',
} = Astro.props;

// set on the body so it propagates to the canvas — overscroll past either
// end of the page has to be the same colour as the page
const groundClass = ground === 'black' ? 'bg-black' : 'bg-ink';
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={ground === 'black' ? '#000000' : '#0a0a0d'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,1..1000&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class:list={['h-full font-display overflow-x-clip', groundClass]}>
    <slot />
  </body>
</html>
